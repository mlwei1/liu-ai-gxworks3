{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gx3gen.local/program_spec.schema.json",
  "title": "gx3gen ProgramSpec",
  "type": "object",
  "required": ["spec_version", "project", "io", "segments"],
  "additionalProperties": true,
  "properties": {
    "spec_version": { "const": "0.1" },
    "project": {
      "type": "object",
      "required": ["name", "cpu"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "enum": ["FX5U"] },
        "gx_version": { "type": "string", "default": "1.082" },
        "style_profile": { "type": ["string", "null"] },
        "base_project": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "io": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["device", "comment"],
        "properties": {
          "device": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*\\\\?[0-9]+([.][0-9]+)?$" },
          "comment": { "type": "string" },
          "role": { "enum": ["input", "output", "inout", "internal"] },
          "type": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "common": {
      "type": "object",
      "properties": {
        "handshake_base": { "type": "integer", "default": 1000 },
        "alarm_base": { "type": "integer", "default": 2000 },
        "alarm_timer_base": { "type": "integer", "default": 10 },
        "start_step": { "type": "integer", "default": 0 },
        "station_step_base": { "type": "integer", "default": 100 },
        "station_step_stride": { "type": "integer", "default": 100 },
        "step_increment": { "type": "integer", "default": 10 },
        "auto_rungs": { "type": "boolean", "default": true }
      },
      "additionalProperties": true
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "kind"],
        "properties": {
          "title": { "type": "string" },
          "kind": { "enum": ["init", "station", "common", "rungs", "statement"] },
          "entry_conditions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "station 段进入条件（如 S0、X0、握手信号）；生成器会生成 SET 首步的进入网络"
          },
          "step_range": {
            "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["step"],
              "properties": {
                "step": { "type": "integer", "minimum": 0 },
                "comment": { "type": "string" },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "comment": { "type": "string" },
                      "set": { "type": "array", "items": { "type": "string" } },
                      "reset": { "type": "array", "items": { "type": "string" } },
                      "out": { "type": "array", "items": { "type": "string" } },
                      "instructions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["op"],
                          "properties": {
                            "op": { "type": "string" },
                            "operands": { "type": "array", "items": { "type": "string" } }
                          }
                        }
                      }
                    }
                  }
                },
                "transition": {
                  "type": "object",
                  "properties": {
                    "conditions": { "type": "array", "items": { "type": "string" } },
                    "next": { "type": ["integer", "null"] },
                    "comment": { "type": "string" }
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "handshake": {
            "type": "object",
            "properties": {
              "in": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["device"],
                  "properties": { "device": { "type": "string" }, "comment": { "type": "string" } }
                }
              },
              "out": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["device"],
                  "properties": { "device": { "type": "string" }, "comment": { "type": "string" } }
                }
              },
              "shift": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "rungs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["instructions"],
              "properties": {
                "comment": { "type": "string" },
                "instructions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["op"],
                    "properties": {
                      "op": { "type": "string" },
                      "operands": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            }
          },
          "statements": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "alarms": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "base": { "type": "integer", "default": 2000 },
        "timer_base": { "type": "integer", "default": 10 },
        "delay": { "type": "integer", "default": 20 },
        "reset_device": { "type": ["string", "null"] },
        "cylinders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "output"],
            "properties": {
              "name": { "type": "string" },
              "output": { "type": "string" },
              "on_sensor": { "type": ["string", "null"] },
              "home_sensor": { "type": ["string", "null"] },
              "alarm_on": { "type": ["string", "null"] },
              "alarm_home": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
